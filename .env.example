# Postgres connection string (local Postgres, or Neon's pooled/direct URL in production)
DATABASE_URL=postgres://localhost:5432/tally_dev

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# The only Google account allowed to sign in
OWNER_EMAIL=

# Splitwise personal API key (secure.splitwise.com/apps → Register your application → API key)
SPLITWISE_API_KEY=
